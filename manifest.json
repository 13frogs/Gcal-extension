{
  "manifest_version": 3,
  "name": "Student Calendar Hours",
  "description": "Track hours spent on each class using Google Calendar.",
  "version": "1.0",

  "permissions": [
    "identity",
    "storage"
  ],

  "host_permissions": [
    "https://www.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "oauth2": {
    "client_id": "792847750279-hkmb48n7mr8jcfv3sdniec7dq612k0ie.apps.googleusercontent.com.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  },

  "icons": {
    "128": "icons/128.png"
  }
}
